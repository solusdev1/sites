{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verdict.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["item_id", "verdict", "motivos", "frame_continuacao", "corte_sugerido", "prompt_correcao"],
  "properties": {
    "item_id": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["aprovado", "rejeitado"]},
    "motivos": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["t", "tipo", "descricao"],
        "properties": {
          "t": {"type": "number", "minimum": 0},
          "tipo": {"enum": ["objeto_duplicado", "rosto", "maos", "cenario", "continuidade", "fisica", "outro"]},
          "descricao": {"type": "string", "minLength": 1}
        }
      }
    },
    "frame_continuacao": {"type": ["string", "null"], "minLength": 1},
    "corte_sugerido": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["inicio", "fim"],
         "properties": {"inicio": {"type": "number", "minimum": 0}, "fim": {"type": "number", "exclusiveMinimum": 0}}}
      ]
    },
    "prompt_correcao": {"type": ["string", "null"], "minLength": 1}
  }
}
