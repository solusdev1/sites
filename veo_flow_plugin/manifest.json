{
  "manifest_version": 3,
  "name": "Flow Copiloto · Luna",
  "version": "1.0.0",
  "description": "Importa filas de prompts, prepara cada passo no Flow ou Gemini (sem iniciar a geração), baixa o vídeo gerado e o último frame.",
  "permissions": [
    "storage",
    "activeTab",
    "downloads"
  ],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Flow Copiloto",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://flow.google.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/field-selection.js",
        "src/flow-actions.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "src/page-upload.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
